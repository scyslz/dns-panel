# 环境配置
NODE_ENV=development

# 服务器配置
PORT=4001

# 数据库配置
DATABASE_URL="file:./database.db"

# JWT 配置
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="7d"

# 加密密钥（用于加密 Cloudflare API Token、EdgeOne 凭证等，必须是 32 字符）
ENCRYPTION_KEY="change-this-to-32-character-key!"

# 账号策略：仅作为「首次创建设置记录」时的默认值，之后一律以设置页保存到数据库的值为准。
# 未设置时默认：公开注册关闭、多用户开启、注册需审核。
# ALLOW_PUBLIC_REGISTRATION=false
# MULTI_USER_ENABLED=true
# 旧库升级且无管理员时，指定提升为管理员的用户名；留空则默认提升最早创建的账号
# BOOTSTRAP_ADMIN_USERNAME="admin"

# 开放 API Key 的哈希 pepper（可选；默认复用 JWT_SECRET，建议单独设置并长期保持不变）
# API_KEY_PEPPER="change-this-to-another-long-random-string"

# 开放 API 幂等（锁租约 / 结果回放时长，秒；0 表示不保留回放）
# IDEMPOTENCY_LOCK_SECONDS=120
# IDEMPOTENCY_RESULT_TTL_SECONDS=86400
# IDEMPOTENCY_AUTO_RESULT_TTL_SECONDS=300

# 腾讯云 EdgeOne 接口域名（可选；默认中国站，国际站可设为 teo.intl.tencentcloudapi.com）
# TEO_API_HOST="teo.tencentcloudapi.com"

# ACME / 证书配置
ACME_ENV=staging
CERTIFICATE_SCHEDULER_INTERVAL_MS=15000
CERTIFICATE_RENEWAL_SCHEDULER_INTERVAL_MS=21600000
ACME_PROPAGATION_DELAY_MS=30000
VENDOR_CERTIFICATE_SCHEDULER_INTERVAL_MS=30000
CERTIFICATE_DEPLOY_SCHEDULER_INTERVAL_MS=30000

# SMTP 配置（用于邮件通知，可选；未在设置中配置 SMTP 时使用）
# SMTP_HOST="smtp.example.com"
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER="user@example.com"
# SMTP_PASS="your-smtp-password"
# SMTP_FROM="DNS Panel <no-reply@example.com>"

# CORS 配置
CORS_ORIGIN="http://localhost:5173"

# 日志配置
LOG_RETENTION_DAYS=90
